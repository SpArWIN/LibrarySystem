{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Storage": "Verbose"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext} | {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Jwt": {
    "SigningKey": "dev-signing-key-CHANGE-ME-AT-LEAST-32-CHARS"
  },
  "RefreshToken": {
    "Pepper": "dev-refresh-pepper-CHANGE-ME"
  },
  "Database": {
    "Provider": "postgres",
    "ConnectionString": "Host=localhost;Port=5432;Database=central_db;Username=postgres;Password=postgres",
    "MigrationsAssembly": "Core.Infrastructure"
  },
  "TenantProvisioning": {
    "Provider": "postgres",
    "AdminConnectionString": "Host=localhost;Port=5432;Database=central_db;Username=postgres;Password=postgres",
    "TenantConnectionStringTemplate": "Host=localhost;Port=5432;Database={db};Username=postgres;Password=postgres",
    "DatabaseNamePrefix": "library_",
    "MigrationsAssembly": "Core.Infrastructure"
  },
  "LibraryDbContextFactory": {
    "EnableDetailedErrors": true,
    "EnableSensitiveDataLogging": false
  }
}

