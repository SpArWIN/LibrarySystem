{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "SystemLibrary.Auth",
    "Audience": "SystemLibrary.Api",
    "SigningKey": "",
    "AccessTokenLifetimeMinutes": 60
  },
  "RefreshToken": {
    "LifetimeDays": 10,
    "Pepper": ""
  },
  "Database": {
    "Provider": "postgres",
    "ConnectionString": "Host=localhost;Port=5432;Database=central_db;Username=postgres;Password=postgres",
    "MigrationsAssembly": "Core.Infrastructure"
  },
  "TenantDatabase": {
    "Provider": "postgres",
    "MigrationsAssembly": "Core.Infrastructure"
  }
}
