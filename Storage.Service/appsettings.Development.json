{
  "Minio": {
    "Endpoint": "localhost",
    "Port": 9000,
    "AccessKey": "root",
    "SecretKey": "admin123",
    "PublicEndpoint": "localhost",
    "PublicPort": 9000,
    "Buckets": {
      "Images": "images",
      "Avatars": "avatars",
      "Documents": "documents",
      "MetaDataImages": "metadata-images"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Storage": "Verbose"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext} | {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
